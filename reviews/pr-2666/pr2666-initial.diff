+  fi
   # Exponential backoff (base * 2^(attempt-1)) capped, plus bounded jitter.
   backoff=$(( BASE_BACKOFF * (1 << (attempt - 1)) ))
   if [ "$backoff" -gt "$MAX_BACKOFF" ]; then
